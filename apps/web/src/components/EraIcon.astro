---
/**
 * Original era icons — hand-drawn SVG glyphs, one per timeline era.
 * Decorative only (aria-hidden); they never carry scientific meaning.
 * Simple geometric line art on a 24×24 grid, stroke = currentColor.
 */
interface Props {
  era: string;
  size?: number;
}
const { era, size = 28 } = Astro.props;

// One original glyph per era id. M = paths, kept minimal and geometric.
const paths: Record<string, string> = {
  // singularity / quantum foam
  "early-universe": `<circle cx="12" cy="12" r="2.5" fill="currentColor"/>
    <path d="M12 4v3M12 17v3M4 12h3M17 12h3M6.5 6.5l2 2M15.5 15.5l2 2M17.5 6.5l-2 2M8.5 15.5l-2 2"/>
    <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"/>`,
  // expanding particles
  "expansion-particle-formation": `<circle cx="12" cy="12" r="1.8" fill="currentColor"/>
    <circle cx="5" cy="7" r="1.4"/><circle cx="19" cy="7" r="1.4"/>
    <circle cx="5" cy="17" r="1.4"/><circle cx="19" cy="17" r="1.4"/>
    <path d="M10.5 10.5L6.5 8M13.5 10.5L17.5 8M10.5 13.5L6.5 16M13.5 13.5L17.5 16" stroke-dasharray="1 2"/>`,
  // CMB — relic radiation everywhere
  "recombination-cmb": `<path d="M4 12a8 8 0 0 1 16 0" />
    <path d="M7 12a5 5 0 0 1 10 0" stroke-dasharray="1.5 2.5"/>
    <circle cx="12" cy="15" r="2"/>
    <path d="M2 12l2-1M22 12l-2-1M12 20v-2" />`,
  // first star ignition
  "first-stars": `<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    <circle cx="12" cy="20" r="1.2" fill="currentColor"/>`,
  // first galaxies — spiral
  "first-galaxies": `<path d="M12 12m0-1a1 1 0 1 1 0 2 1 1 0 1 1 0-2"/>
    <path d="M12 12c0-3 2.5-4.5 5-3.5M12 12c3 0 4.5 2.5 3.5 5M12 12c0 3-2.5 4.5-5 3.5M12 12c-3 0-4.5-2.5-3.5-5"/>`,
  // cosmic web filaments
  "structure-formation": `<path d="M4 6l5 4-2 5 6 2M20 6l-5 4 2 5-6 2" />
    <circle cx="9.5" cy="10.5" r="1.1" fill="currentColor"/>
    <circle cx="14.5" cy="10.5" r="1.1" fill="currentColor"/>
    <circle cx="7" cy="15.5" r="1.1" fill="currentColor"/>
    <circle cx="17" cy="15.5" r="1.1" fill="currentColor"/>`,
  // protoplanetary disk
  "solar-system-formation": `<circle cx="12" cy="12" r="2.2" fill="currentColor"/>
    <ellipse cx="12" cy="12" rx="9" ry="3.5"/>
    <circle cx="19.5" cy="13.5" r="1.3" fill="currentColor"/>`,
  // young Earth + Moon
  "earth-geological-history": `<circle cx="10.5" cy="12" r="6"/>
    <path d="M7.5 10.5c1-1 2-1 3 0s2 1 3 0M8 13.5c1-.8 2-.8 3 0"/>
    <circle cx="19" cy="7.5" r="2.2"/>`,
  // tree of life
  "evolution-of-life": `<path d="M12 21v-6"/>
    <path d="M12 15c-3 0-4.5-2-4-4.5C8.5 8 10.5 7 12 7s3.5 1 4 3.5c.5 2.5-1 4.5-4 4.5z"/>
    <path d="M10 7L9 4M14 7l1-3"/>`,
  // telescope / discovery
  "human-civilization-discovery": `<path d="M4 20l6-6"/>
    <rect x="9" y="6" width="8" height="5" rx="1" transform="rotate(-30 13 8.5)"/>
    <path d="M17 12l2 4M4 20h5"/>`,
  // rocket launch
  "space-exploration": `<path d="M12 3c2.5 2 3.5 5 3 8l-3 3-3-3c-.5-3 .5-6 3-8z"/>
    <circle cx="12" cy="8" r="1.4"/>
    <path d="M9 12l-2.5 2M15 12l2.5 2M12 14v5l-2 2M12 14v0"/>`,
  // conditional future — branching paths
  "conditional-future": `<path d="M4 19h5l4-6"/>
    <path d="M13 13l3-7 4 3" stroke-dasharray="2 2"/>
    <path d="M13 13l3 5 4-1" stroke-dasharray="2 2"/>
    <circle cx="8" cy="19" r="1.2" fill="currentColor"/>`,
};

const glyph = paths[era] ?? paths["early-universe"];
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={glyph}
/>
