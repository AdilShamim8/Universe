---
import "@universe/ui/tokens.css";
import "@universe/ui/base.css";
import "@universe/ui/components.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/site.css";
import { header, footer, themeToggle } from "@universe/ui";

interface Props {
  title: string;
  description?: string;
  /** Current nav route for aria-current. */
  current?: string;
  /** Exclude this page from search indexing (fixtures, empty sections). */
  noindex?: boolean;
  /** Canonical path override (defaults to Astro.url.pathname). */
  canonical?: string;
}

const { title, description, current, noindex, canonical } = Astro.props;
const SITE = "https://universe-101.vercel.app";
const canonicalURL = new URL(canonical ?? Astro.url.pathname, SITE);
const ogImage = new URL("/og-default.svg", SITE);
const navEntries = [
  { route: "/", title: "Home" },
  { route: "/history/", title: "History" },
  { route: "/academy/", title: "Academy" },
  { route: "/explore/", title: "Explore" },
  { route: "/research/", title: "Research" },
  { route: "/library/", title: "Library" },
].map((n) => ({
  ...n,
  current: current !== undefined && (current === "/" ? n.route === "/" : n.route !== "/" && current.startsWith(n.route)),
}));
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Universe</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Universe 101" />
    <meta property="og:title" content={`${title} · Universe`} />
    <meta property="og:description" content={description ?? "Learn, explore and research the universe — a curated, source-backed guide from beginner to research level."} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Theme + motion preferences before first paint (no flash). The toggle
      // stays hidden when JS is unavailable (progressive enhancement only).
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var media = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.dataset.theme = stored === "light" || stored === "dark" ? stored : media;
        } catch (e) {
          /* private mode: keep default dark */
        }
        document.addEventListener("DOMContentLoaded", function () {
          var btn = document.querySelector("[data-theme-toggle]");
          if (!btn) return;
          btn.hidden = false;
          btn.addEventListener("click", function () {
            var next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem("theme", next); } catch (e) { /* ignore */ }
          });
        });
      })();
    </script>
  </head>
  <body>
    <div class="starfield" aria-hidden="true"></div>
    <Fragment set:html={header(navEntries, { brand: "Universe", tagline: "Learn, explore and research the cosmos" })} />
    <Fragment set:html={themeToggle()} />
    <main id="main">
      <slot />
    </main>
    <Fragment set:html={footer({
      status: "Curated educational directory · original science pending human review",
      license: "Code Apache-2.0 proposed · content CC BY 4.0 proposed",
    })} />
  </body>
</html>
