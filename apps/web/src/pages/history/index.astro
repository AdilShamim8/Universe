---
import Base from "../../layouts/Base.astro";
import { loadTimeline } from "../../lib/curated";

const { data: timeline, provenance } = loadTimeline();
const { model, eras } = timeline;
const totalEvents = eras.reduce((n, e) => n + e.events.length, 0);
---
<Base
  title="Universe History"
  description={`A source-backed timeline of the cosmos — ${totalEvents} events across ${eras.length} eras, from the Big Bang to the distant future.`}
  current="/history/"
>
  <section class="hero">
    <p class="hero-eyebrow">{model.name} · age {model.ageGyr} ± {model.ageUncertaintyGyr} Gyr</p>
    <h1 class="hero-title">The history of everything</h1>
    <p class="hero-lede">
      {totalEvents} events across {eras.length} eras — from the first fraction of a second to
      the conditional far future. Every event carries its authoritative source, date precision
      and stated uncertainty. Model-dependent ages follow {model.reference}.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#early-universe">Begin at the Big Bang</a>
      <a class="btn btn-secondary" href="/academy/">Learn the physics first</a>
    </div>
  </section>

  <div class="container-pad">
    <nav aria-label="Timeline eras">
      <ul class="timeline-era-nav">
        {eras.map((era) => (
          <li><a href={`#${era.id}`}>{era.order}. {era.title}</a></li>
        ))}
      </ul>
    </nav>

    {eras.map((era) => (
      <section class="timeline-era" id={era.id} aria-labelledby={`${era.id}-h`}>
        <h2 id={`${era.id}-h`}>{era.order}. {era.title}</h2>
        <p class="era-summary">{era.summary}</p>
        <ol class="timeline-events">
          {era.events.map((ev) => (
            <li class="timeline-event" id={ev.id}>
              <h3>{ev.title}</h3>
              <span class="event-time">{ev.display}</span>
              <p>{ev.summary}</p>
              {ev.time.uncertainty && (
                <p class="event-uncertainty">Uncertainty: {ev.time.uncertainty}{ev.cosmologicalModel ? ` · model: ${ev.cosmologicalModel}` : ""}</p>
              )}
              <div class="source-line">
                Source: <a href={ev.source.url} rel="noopener">{ev.source.label}</a>
                {ev.links?.map((l) => (
                  <> · <a href={l.url} rel="noopener">{l.label}</a></>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p class="muted">
      Timeline content is a curated, source-linked dataset (verified {provenance.verification.verifiedOn}).
      Event summaries state standard consensus science from the cited sources; they are not
      original scientific claims. Future-era events are model-dependent projections, not predictions.
    </p>
  </div>
</Base>
