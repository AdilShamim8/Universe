---
import Base from "../layouts/Base.astro";
import { emptyState } from "@universe/ui";
import { loadSiteModel } from "../lib/site-data";

const { data } = loadSiteModel();
const searchableCount =
  data.concepts.length + data.lessons.length + data.claims.length +
  data.sources.length + data.researchQuestions.length + data.events.length;
---
<Base title="Search" description="Search reviewed records across the platform." current="/explore/" noindex={searchableCount === 0}>
  <h1>Search</h1>
  <p>
    Full-text search over approved records, powered by
    <a href="https://pagefind.app/">Pagefind</a> at build time. Drafts, fixtures, and
    quarantined candidates are structurally excluded from the index — they never reach
    the build output that Pagefind scans.
  </p>

  {searchableCount === 0 ? emptyState(
    "Nothing to search yet",
    "The search index contains zero approved records, so search is disabled rather than pretending to find things. It activates automatically once reviewed records exist.",
    { awaitingReview: true },
  ) : (
    <div class="search-box">
      <input type="search" id="search" class="search-input" placeholder={`Search ${searchableCount} approved records…`} aria-label="Search approved records" />
      <button type="button" id="search-btn" class="theme-toggle">Search</button>
    </div>
  )}

  <div id="search-results" class="search-results" aria-live="polite"></div>

  {searchableCount > 0 && (
    <script is:inline>
      // Pagefind loads only when an index exists (built post-astro-build).
      (async function () {
        try {
          const pagefind = await import("/pagefind/pagefind.js");
          const input = document.getElementById("search");
          const results = document.getElementById("search-results");
          async function run() {
            const q = input.value.trim();
            if (q.length === 0) { results.innerHTML = ""; return; }
            const search = await pagefind.search(q);
            const top = search.results.slice(0, 10);
            const items = await Promise.all(top.map((r) => r.data()));
            results.innerHTML = items.length === 0
              ? "<p>No approved records match.</p>"
              : "<ul class=\"section-grid\">" + items.map((d) =>
                  `<li><a href="${d.url}"><div class="section-card-title">${d.meta.title}</div></a></li>`
                ).join("") + "</ul>";
          }
          input.addEventListener("input", debounce(run, 200));
          function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
        } catch (e) {
          document.getElementById("search-results").innerHTML =
            "<p>Search index unavailable.</p>";
        }
      })();
    </script>
  )}
</Base>
