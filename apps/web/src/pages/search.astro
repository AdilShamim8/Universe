---
import Base from "../layouts/Base.astro";
---
<Base title="Search" description="Search the platform — history events, learning pathways, resources and research fields." current="/explore/">
  <div class="container-pad">
    <section class="hero" style="padding-block: var(--space-16);">
      <p class="hero-eyebrow">Full-text search</p>
      <h1 class="hero-title" style="font-size: var(--text-3xl);">Search</h1>
      <p class="hero-lede">
        Search across timeline events, learning pathways, library resources and research fields.
        Powered by Pagefind at build time — every public page is indexed.
      </p>
    </section>
    <div class="search-box" style="max-width: 42rem; margin-inline: auto;">
      <input type="search" id="search" class="search-input" placeholder="Search the universe…" aria-label="Search the platform" />
    </div>
    <div id="search-results" class="search-results" aria-live="polite" style="max-width: 42rem; margin-inline: auto;"></div>

    <script is:inline>
      // Pagefind loads only when an index exists (built post-astro-build).
      (async function () {
        try {
          const pagefind = await import("/pagefind/pagefind.js");
          const input = document.getElementById("search");
          const results = document.getElementById("search-results");
          async function run() {
            const q = input.value.trim();
            if (q.length === 0) { results.innerHTML = ""; return; }
            const search = await pagefind.search(q);
            const top = search.results.slice(0, 10);
            const items = await Promise.all(top.map((r) => r.data()));
            results.innerHTML = items.length === 0
              ? "<p>No pages match that search.</p>"
              : "<ul class=\"search-result-list\">" + items.map((d) =>
                  `<li><a href="${d.url}">${d.meta.title}</a></li>`
                ).join("") + "</ul>";
          }
          input.addEventListener("input", debounce(run, 200));
          function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
        } catch (e) {
          document.getElementById("search-results").innerHTML =
            "<p>Search index unavailable.</p>";
        }
      })();
    </script>
    <style>
      .search-result-list { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
      .search-result-list a {
        display: block; padding: var(--space-3) var(--space-4);
        background: var(--bg-2); border: var(--border-1) solid var(--border-0);
        border-radius: var(--radius-md); color: var(--fg-0); text-decoration: none;
      }
      .search-result-list a:hover { border-color: var(--accent-0); }
    </style>
  </div>
</Base>
