{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universe-platform.dev/contracts/path.schema.json",
  "title": "Learning path record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "title", "goal", "level", "lesson_refs", "status"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/record_id" },
    "kind": { "enum": ["learning-path", "research-path", "career-path"] },
    "title": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "goal": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "lesson_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/record_id" },
      "description": "Ordered lesson IDs; must not contain cycles (validated by registry)."
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "description": { "type": "string", "maxLength": 1000 },
          "lesson_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/record_id" } }
        }
      }
    },
    "alternatives": { "type": "string", "maxLength": 2000, "description": "Optional alternative routes." },
    "status": { "$ref": "common.schema.json#/$defs/lifecycle_status" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" }
  }
}
