{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universe-platform.dev/contracts/release-manifest.schema.json",
  "title": "Release manifest",
  "description": "Immutable record of what was released, from what, and with which verification. Generated by tools/release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "created_at", "git_commit", "contract_schema_version", "approved_record_count", "excluded", "verification", "artifact"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created_at": { "$ref": "common.schema.json#/$defs/date" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contract_schema_version": { "type": "integer", "minimum": 1 },
    "module_revisions": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 },
      "description": "Highest record revision per module at release."
    },
    "approved_record_count": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "description": "Counts of approved records by type in the public projection."
    },
    "source_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "retrieved_at"],
        "properties": {
          "source_id": { "$ref": "common.schema.json#/$defs/record_id" },
          "version": { "type": "string", "maxLength": 100 },
          "retrieved_at": { "$ref": "common.schema.json#/$defs/date" }
        }
      }
    },
    "dependency_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "description": "Records excluded from public output by the fail-closed projection, by reason (draft, fixture, revoked, restricted...)."
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "test"],
      "properties": {
        "validate": { "enum": ["pass", "fail", "not-run"] },
        "lint": { "enum": ["pass", "fail", "not-run"] },
        "typecheck": { "enum": ["pass", "fail", "not-run"] },
        "test": { "enum": ["pass", "fail", "not-run"] },
        "build": { "enum": ["pass", "fail", "not-run"] },
        "e2e": { "enum": ["pass", "fail", "not-run"] },
        "test_summary": { "type": "string", "maxLength": 500, "description": "e.g. '214 passed, 3 skipped'." }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "enum": ["local-tarball", "github-artifact", "none"] },
        "digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "withdrawn_records": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/record_id" },
      "description": "Records withdrawn since the previous release; rollback must not silently restore them (see tools/release)."
    },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
