{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "browser": true, "node": true, "es2022": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "eqeqeq": ["error", "smart"]
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".astro/**", "coverage/**"]
}
