{
  "name": "universe-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Universe Learning Platform — an open, modular scientific learning infrastructure (engineering preview). Internal neutral codename: universe-platform; public name pending owner decision.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "tests/browser"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "validate": "tsx tools/validation/src/cli.ts",
    "test": "vitest run --root .",
    "build": "npm run build -w apps/web",
    "test:e2e": "npm run test -w tests/browser",
    "ingest:dry-run": "tsx tools/ingestion/src/cli.ts --dry-run",
    "lint": "oxlint --config oxlintrc.json .",
    "typecheck": "tsc --build tsconfig.base.json --dry > /dev/null 2>&1; tsc -p tsconfig.ci.json --noEmit",
    "release:manifest": "tsx tools/release/src/cli.ts",
    "preview": "npm run preview -w apps/web"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
